# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored, so your key never leaves your machine.
# On Vercel, add these same three under Settings → Environment Variables.

# 1. Sign up free at https://resend.com, then API Keys → Create API Key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. Where contact-form messages get delivered. Use the SAME address you
#    signed up to Resend with, otherwise the free sandbox will refuse to send.
CONTACT_TO_EMAIL=hj791983@outlook.com

# 3. Leave this as-is until you verify your own domain in Resend.
#    After verifying, change it to something like: Portfolio <hello@yourdomain.com>
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# 4. OPTIONAL — Microsoft Clarity analytics (heatmaps + session recordings).
#    Free at https://clarity.microsoft.com. Create a project, then copy the
#    project ID out of the install snippet it shows you.
#    Leave this blank to turn analytics off. It only loads in production, so
#    your own local browsing never shows up in the data.
NEXT_PUBLIC_CLARITY_ID=yhasxbcco4

# 5. Chatbot ("AI version of Hardik"). Both keys are FREE and need no card.
#    Without any key the chat still works: small talk and common questions are
#    answered without AI, and everything else gets a plain-text reply from the site.
#
#    IMPORTANT: never attach a payment method to these accounts. On free plans,
#    heavy traffic can only use up the free allowance; it can never cost money.
#
#    Groq: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=
#    Gemini (optional second provider): https://aistudio.google.com → Get API key.
#    Use a Google Cloud project with billing DISABLED. Google may use free-tier
#    prompts to improve its products; leave this blank to skip Gemini entirely.
GEMINI_API_KEY=

#    Advanced, usually leave as-is. Check each provider's model list if they
#    retire a model: console.groq.com/docs/models, ai.google.dev/gemini-api/docs/models
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GEMINI_MODEL=gemini-3.5-flash-lite
# CHAT_RATE_LIMIT_PER_10MIN=20
# CHAT_RATE_LIMIT_PER_DAY=60
